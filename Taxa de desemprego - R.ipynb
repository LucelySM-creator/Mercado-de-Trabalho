Código-fonte
# ============================================================
# MERCADO DE TRABALHO NO BRASIL
# SIDRA/IBGE - Tabela 4093: abas 5, 27 e 29
# ============================================================
# 1. PACOTES
pacotes <- c("readxl", "dplyr", "tidyr", "ggplot2", "patchwork", "scales", "knitr")
faltantes <- pacotes[!vapply(pacotes, requireNamespace, logical(1), quietly = TRUE)]
if (length(faltantes) > 0) {
 stop("Instale os pacotes: ", paste(faltantes, collapse = ", "))
}
invisible(lapply(pacotes, library, character.only = TRUE))
# 2. CONFIGURACOES
arquivo <- "Tabela 4093 SIDRA IBGE.xlsx"
if (!file.exists(arquivo)) stop("Arquivo nao encontrado: ", arquivo)
trimestres <- c(
 "1º trimestre 2025", "2º trimestre 2025", "3º trimestre 2025",
 "4º trimestre 2025", "1º trimestre 2026", "2º trimestre 2026"
)
grupos <- c("Total", "Homens", "Mulheres")
cores <- c("Total" = "#264653", "Homens" = "#2A9D8F", "Mulheres" = "#E76F51")
formato_pct <- label_number(decimal.mark = ",", accuracy = 0.1, suffix = "%")
# 3. FUNCOES
ler_indicador <- function(aba, indicador, unidade) {
 dados <- read_excel(arquivo, sheet = aba, col_names = FALSE, .name_repair = "minimal")
 linha <- which(trimws(as.character(dados[[1]])) == "Brasil")
 if (length(linha) != 1) stop("Linha Brasil nao identificada na aba ", aba)
 valores <- suppressWarnings(as.numeric(unlist(dados[linha, 2:19], use.names = FALSE)))
 if (length(valores) != 18 || anyNA(valores)) {
 stop("A aba ", aba, " nao possui os 18 valores numericos esperados.")
 }
 expand_grid(
 Trimestre = factor(trimestres, levels = trimestres),
 Grupo = factor(grupos, levels = grupos)
 ) |>
 mutate(Valor = valores, Indicador = indicador, Unidade = unidade)
}
variacao_relativa <- function(inicial, final) {
 ifelse(is.na(inicial) | is.na(final) | inicial == 0,
 NA_real_, 100 * (final / inicial - 1))
}
formatar_variacao <- function(x, sufixo) {
 ifelse(is.na(x), "Nao calculada",
 paste0(ifelse(x > 0, "+", ""),
 format(round(x, 2), decimal.mark = ",", nsmall = 2), sufixo))
}
# 4. IMPORTACAO
forca_trabalho <- ler_indicador("Tabela 5", "Força de trabalho", "Mil pessoas")
taxa_desocupacao <- ler_indicador("Tabela 27", "Taxa de desocupação", "%")
taxa_informalidade <- ler_indicador("Tabela 29", "Taxa de informalidade", "%")
base_completa <- bind_rows(forca_trabalho, taxa_desocupacao, taxa_informalidade)
# 5. COMPARACAO ENTRE O 1º E O 2º TRIMESTRES DE 2026
comparacao_2026 <- base_completa |>
 filter(Trimestre %in% c("1º trimestre 2026", "2º trimestre 2026")) |>
 select(Indicador, Unidade, Grupo, Trimestre, Valor) |>
 pivot_wider(names_from = Trimestre, values_from = Valor) |>
 mutate(
 Variacao = if_else(
 Unidade == "%",
 `2º trimestre 2026` - `1º trimestre 2026`,
 variacao_relativa(`1º trimestre 2026`, `2º trimestre 2026`)
 ),
 `Variação` = if_else(
 Unidade == "%",
 formatar_variacao(Variacao, " p.p."),
 formatar_variacao(Variacao, "%")
 )
 )
print(kable(
 comparacao_2026 |>
 select(Indicador, Grupo, `1º trimestre 2026`, `2º trimestre 2026`, `Variação`),
 digits = 1,
 caption = "Indicadores do mercado de trabalho brasileiro"
))
# 6. SINTESE AUTOMATICA
resultado_total <- comparacao_2026 |> filter(Grupo == "Total")
forca_total <- resultado_total |> filter(Indicador == "Força de trabalho")
desocupacao_total <- resultado_total |> filter(Indicador == "Taxa de desocupação")
informalidade_total <- resultado_total |> filter(Indicador == "Taxa de informalidade")
cat("\nSINTESE DOS RESULTADOS\n")
      cat(sprintf(
 "Força de trabalho: %.0f mil para %.0f mil pessoas (%s).\n",
 forca_total$`1º trimestre 2026`, forca_total$`2º trimestre 2026`, forca_total$`Variação`
))
cat(sprintf(
 "Taxa de desocupação: %.1f%% para %.1f%% (%s).\n",
 desocupacao_total$`1º trimestre 2026`, desocupacao_total$`2º trimestre 2026`, desocupacao_total$`Variação`
))
cat(sprintf(
 "Taxa de informalidade: %.1f%% para %.1f%% (%s).\n",
 informalidade_total$`1º trimestre 2026`, informalidade_total$`2º trimestre 2026`, 
informalidade_total$`Variação`
))
# 7. GRAFICOS
tema <- theme_minimal(base_size = 11) +
 theme(
 plot.title = element_text(face = "bold", hjust = 0.5),
 plot.subtitle = element_text(hjust = 0.5),
 axis.title.x = element_blank(),
 axis.text.x = element_text(angle = 35, hjust = 1),
 panel.grid.minor = element_blank(),
 legend.position = "top"
 )
grafico_forca <- ggplot(
 forca_trabalho,
 aes(Trimestre, Valor / 1000, color = Grupo, group = Grupo)
) +
 geom_line(linewidth = 1) + geom_point(size = 2.5) +
 scale_color_manual(values = cores) +
 scale_y_continuous(labels = label_number(decimal.mark = ",", accuracy = 0.1)) +
 labs(title = "Força de trabalho por sexo", y = "Milhões de pessoas", color = NULL) + tema
grafico_desocupacao <- ggplot(
 taxa_desocupacao,
 aes(Trimestre, Valor, color = Grupo, group = Grupo)
) +
 geom_line(linewidth = 1) + geom_point(size = 2.5) +
 scale_color_manual(values = cores) + scale_y_continuous(labels = formato_pct) +
 labs(title = "Taxa de desocupação por sexo", y = "Taxa (%)", color = NULL) + tema
grafico_informalidade <- ggplot(
 taxa_informalidade,
 aes(Trimestre, Valor, color = Grupo, group = Grupo)
) +
 geom_line(linewidth = 1) + geom_point(size = 2.5) +
 scale_color_manual(values = cores) + scale_y_continuous(labels = formato_pct) +
 labs(title = "Taxa de informalidade por sexo", y = "Taxa (%)", color = NULL) + tema
painel <- grafico_forca / (grafico_desocupacao | grafico_informalidade) +
 plot_annotation(
 title = "Indicadores do mercado de trabalho brasileiro",
 subtitle = "Fonte: IBGE - PNAD Contínua Trimestral - SIDRA 4093"
 )
print(painel)
# 8. EXPORTACAO
ggsave("painel_mercado_trabalho.png", painel, width = 13, height = 9, dpi = 300)
write.csv2(comparacao_2026, "comparacao_mercado_trabalho_2026.csv",
 row.names = FALSE, fileEncoding = "UTF-8")
